<body name="can_body" pos="0.42 -0.03 1.03">
  <!-- Physical can with good contact params -->
  <geom name="can_geom" type="cylinder" size="0.03 0.06"
        rgba="0.9 0.6 0.2 1"
        friction="1.0 0.005 0.0001"
        contype="1" conaffinity="1"
        margin="0.003" solimp="0.90 0.99 0.001" solref="0.003 1"/>
  <!-- Free joint so the env can randomize pose (x,y,z,yaw/pitch/roll) -->
  <joint name="can_free" type="free"/>

  <!-- viz sites for debugging -->
  <site name="can_center"  pos="0 0 0"      size="0.004" type="sphere" rgba="0.6 0.6 0.6 0.5"/>
  <!-- radius = 0.03 → put a green dot at radius+margin on +Y -->
  <site name="can_site"    pos="0 0.036 0"  size="0.006" type="sphere" rgba="0.2 0.9 0.2 1"/>
  <!-- standoff markers at radius+standoff (0.05) on ±Y -->
  <site name="standoff_right" pos="0  0.05 0" size="0.006" type="sphere" rgba="0.9 0.2 0.2 1"/>
  <site name="standoff_left"  pos="0 -0.05 0" size="0.006" type="sphere" rgba="0.9 0.2 0.2 1"/>
</body>